# Server
PORT=5000
# Optional override. Packaged Electron supplies its own app-data directory.
# COPILOT_DATA_DIR=/absolute/path/to/copilot-data

# Required in production: at least 32 random characters and not a placeholder.
# Example generator: openssl rand -hex 48
JWT_SECRET=

# Use at least one AI provider in production.
GROQ_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Stripe is optional. If enabled, all three values are required.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
